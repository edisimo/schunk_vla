<?xml version="1.0"?>
<package format="3">
  <name>lwa4p_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control hardware plugin for the Schunk LWA 4P in CiA 402 interpolated position mode (SocketCAN, SYNC-clocked PDOs)</description>
  <maintainer email="edisimo@users.noreply.github.com">Eduard Zelenay</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_srvs</depend>
  <depend>controller_manager_msgs</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>lwa4p_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
