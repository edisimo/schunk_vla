<?xml version="1.0"?>
<package format="3">
  <name>lwa4p_vla_bridge</name>
  <version>0.1.0</version>
  <description>TCP bridge between a LeRobot process and the LWA 4P ROS 2 driver, with safety checks</description>
  <maintainer email="edisimo@users.noreply.github.com">Eduard Zelenay</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>lwa4p_moveit_config</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
